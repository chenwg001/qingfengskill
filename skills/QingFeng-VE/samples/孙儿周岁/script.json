{
  "title": "孙儿周岁",
  "mode": "topic",
  "tone": "抒情温润·诗意",
  "speed": 4.2,
  "duration_target": 120,
  "duration_est": 120.2,
  "total_chars": 505,
  "char_note": "total_chars 与 duration_est 均按纯汉字计（标点不计时）；与 script.txt 中文数一致",
  "sentences": [
    {"index": 1, "text": "去年这个时候，你刚来。", "mood": "轻柔", "duration_est": 2.14},
    {"index": 2, "text": "那么小一团，抱在怀里，连哭都只是哼哼。", "mood": "温情", "duration_est": 3.81},
    {"index": 3, "text": "护士把你放在我臂弯里，你眼睛还没睁开，手却攥着我的手指，攥得死死的。", "mood": "温情", "duration_est": 7.14},
    {"index": 4, "text": "一年就这样过去了。", "mood": "舒缓", "duration_est": 1.90},
    {"index": 5, "text": "你学会了翻身，学会了坐，学会了扶着沙发的靠背一点点挪。", "mood": "轻快", "duration_est": 5.71},
    {"index": 6, "text": "你咧嘴笑的时候，两颗小门牙顶着下唇，像刚刚偷了糖。", "mood": "轻快", "duration_est": 5.24},
    {"index": 7, "text": "你半夜醒了，不哭，就咿咿呀呀跟自己说话，像在念什么只有你懂的经。", "mood": "温情", "duration_est": 6.67},
    {"index": 8, "text": "春天里，我推着你的小车在小区里转悠。", "mood": "舒缓", "duration_est": 3.81},
    {"index": 9, "text": "你指着树上的麻雀，嘴里嘟囔着，仿佛在跟它们打招呼。", "mood": "轻快", "duration_est": 5.24},
    {"index": 10, "text": "风把你的小帽子吹掉了，你也不恼，只顾着笑。", "mood": "轻快", "duration_est": 4.29},
    {"index": 11, "text": "今天是你的周岁。", "mood": "温暖", "duration_est": 1.67},
    {"index": 12, "text": "桌上摆了鸡蛋、书本、算盘，还有一支笔——老人家的老讲究，叫抓周。", "mood": "温情", "duration_est": 5.95},
    {"index": 13, "text": "你不管那些，伸手就把鸡蛋攥住了，攥得紧紧的，谁也抢不走。", "mood": "欢喜", "duration_est": 5.71},
    {"index": 14, "text": "你妈妈举着手机，从天亮拍到天黑。", "mood": "温情", "duration_est": 3.33},
    {"index": 15, "text": "你爸一早钻进厨房，长寿面出锅比别人多煮了一碗，说要年年有余。", "mood": "温情", "duration_est": 6.43},
    {"index": 16, "text": "你奶奶把你周岁穿的小衣服叠好，闻着上面淡淡的奶香味，舍不得放下。", "mood": "温情", "duration_est": 6.90},
    {"index": 17, "text": "亲戚们来了，塞给你红包，把你举过头顶转圈圈。", "mood": "热闹", "duration_est": 4.52},
    {"index": 18, "text": "你咯咯笑着，一点也不怕。", "mood": "轻快", "duration_est": 2.38},
    {"index": 19, "text": "你还不懂得今天和昨天有什么不同。", "mood": "舒缓", "duration_est": 3.57},
    {"index": 20, "text": "你只管玩，玩累了，往我怀里一倒，睡着了，小手还勾着我的衣角。", "mood": "温情", "duration_est": 5.95},
    {"index": 21, "text": "夜里你睡了，屋里静下来。", "mood": "舒缓", "duration_est": 2.38},
    {"index": 22, "text": "我坐在床边看了你很久，看你小小的胸口一起一伏。", "mood": "温情", "duration_est": 5.00},
    {"index": 23, "text": "这一年的欢喜，原来都藏在这些不起眼的夜里。", "mood": "感慨", "duration_est": 4.52},
    {"index": 24, "text": "我抱过你爸，也抱过你。", "mood": "温情", "duration_est": 2.14},
    {"index": 25, "text": "如今看着你，才慢慢明白，当年你太奶奶抱着我时，手也是这么轻。", "mood": "感慨", "duration_est": 6.19},
    {"index": 26, "text": "慢慢长大吧，我的小孙儿。", "mood": "慈爱", "duration_est": 2.38},
    {"index": 27, "text": "一岁，才刚刚开头。", "mood": "舒缓", "duration_est": 1.67},
    {"index": 28, "text": "往后的路还长，爷爷陪你，一步一步走。", "mood": "温情", "duration_est": 3.57}
  ]
}
